includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    level: max
    paths:
        - routes
        - src
    typeAliases:
        # Every response/payload shape lives as @phpstan-type on the class it describes.
        # This one has no owner: it is the JSON scalar primitive shared by manager,
        # fake, logging, error mapping and webhook middleware alike.
        WlcmJsonScalar: 'bool|int|float|string|null'
